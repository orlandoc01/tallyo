{
  "name": "tallyo-web",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "generate:schema": "node scripts/generate-schema.mjs",
    "generate:types": "node scripts/generate-types.mjs",
    "generate": "npm run generate:schema && npm run generate:types",
    "predev": "npm run generate",
    "dev": "vite",
    "dev:stub": "VITE_STUB_API=true vite",
    "prebuild": "npm run generate",
    "build": "tsc --noEmit && NODE_OPTIONS=--experimental-global-webcrypto vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run generate",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:components && npm run test:integration",
    "test:unit": "vitest run src/utils/*.test.ts",
    "test:components": "vitest run src/components/**/*.test.tsx",
    "test:integration": "vitest run src/App.integration.test.tsx",
    "pretest:coverage": "npm run generate",
    "test:coverage": "vitest run --coverage src/utils/*.test.ts src/graphql/*.test.ts src/hooks/*.test.ts src/hooks/*.test.tsx src/pages/*.test.tsx src/components/**/*.test.tsx src/App.integration.test.tsx",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "audit": "fallow dead-code && fallow dupes && fallow health --score --hotspots --targets"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@simplewebauthn/browser": "^13.3.0",
    "@urql/core": "^6.0.3",
    "@urql/exchange-graphcache": "^9.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "graphql": "^16.11.0",
    "lucide-react": "^0.511.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-plaid-link": "^4.1.1",
    "react-router": "^8.1.0",
    "recharts": "^3.10.1",
    "urql": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@graphql-codegen/core": "^6.1.0",
    "@graphql-codegen/typescript": "^6.0.2",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.27.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fallow": "^3.4.2",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "msw": "^2.8.7",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "overrides": {
    "minimatch": "^10.2.5"
  }
}
